<Window
    x:Class="LibChess.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LibChess.WinUI">

    <Grid x:Name="RootGrid" Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Grid.Row="0"
            Title="LibChess">
            <TitleBar.IconSource>
                <FontIconSource FontFamily="Segoe UI Symbol" Glyph="&#x265E;" />
            </TitleBar.IconSource>
        </TitleBar>

        <ScrollViewer
            x:Name="LauncherView"
            Grid.Row="1"
            HorizontalContentAlignment="Stretch"
            HorizontalScrollBarVisibility="Disabled"
            HorizontalScrollMode="Disabled"
            VerticalScrollBarVisibility="Auto">
            <Grid
                MaxWidth="1040"
                Padding="56,40,56,64"
                HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Spacing="6">
                    <TextBlock
                        FontSize="32"
                        FontWeight="SemiBold"
                        Text="Welcome to LibChess" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Choose an online service or a local engine."
                        Style="{StaticResource SubtitleTextBlockStyle}" />
                </StackPanel>

                <Grid
                    x:Name="BackendCards"
                    Grid.Row="1"
                    Margin="0,28,0,0"
                    ColumnSpacing="16"
                    RowSpacing="16" />

                <StackPanel
                    x:Name="BackendLoading"
                    Grid.Row="1"
                    Margin="0,42,0,0"
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <ProgressRing Width="20" Height="20" IsActive="True" />
                    <TextBlock VerticalAlignment="Center" Text="Discovering chess backends…" />
                </StackPanel>

                <Border
                    Grid.Row="2"
                    Margin="0,24,0,0"
                    Padding="24"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="12">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="48"
                            Height="48"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="8">
                            <FontIcon
                                x:Name="BackendIcon"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                FontFamily="Segoe Fluent Icons"
                                FontSize="22"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE950;" />
                        </Border>

                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock
                                x:Name="BackendName"
                                Text="Choose where to play"
                                TextWrapping="Wrap"
                                Style="{StaticResource TitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="BackendSubtitle"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Text="Select a card to see more information."
                                TextWrapping="Wrap"
                                Style="{StaticResource BodyStrongTextBlockStyle}" />
                            <TextBlock
                                x:Name="BackendDescription"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="BackendActionButton"
                                HorizontalAlignment="Left"
                                Click="BackendActionButton_Click"
                                Style="{StaticResource AccentButtonStyle}"
                                Visibility="Collapsed" />
                            <ProgressBar
                                x:Name="BackendProgress"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Grid>
                </Border>

                <InfoBar
                    x:Name="LauncherInfoBar"
                    Grid.Row="3"
                    Margin="0,16,0,0"
                    IsClosable="True"
                    IsOpen="False"
                    Severity="Informational" />
            </Grid>
        </ScrollViewer>

        <Grid x:Name="WorkspaceView" Grid.Row="1" Visibility="Collapsed">
            <NavigationView
                x:Name="MainNavigation"
                AlwaysShowHeader="False"
                CompactModeThresholdWidth="720"
                CompactPaneLength="48"
                ExpandedModeThresholdWidth="1000"
                IsBackButtonVisible="Collapsed"
                IsPaneOpen="True"
                IsSettingsVisible="False"
                OpenPaneLength="248"
                PaneDisplayMode="Auto"
                SelectionChanged="MainNavigation_SelectionChanged">
                <NavigationView.PaneHeader>
                    <StackPanel Margin="8,4,8,16" Orientation="Horizontal" Spacing="12">
                        <FontIcon
                            VerticalAlignment="Center"
                            FontFamily="Segoe UI Symbol"
                            FontSize="20"
                            Glyph="&#x265E;" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Text="LibChess" />
                    </StackPanel>
                </NavigationView.PaneHeader>
                <NavigationView.MenuItems>
                    <NavigationViewItem Content="New game" Tag="new-game">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Add" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                    <NavigationViewItem x:Name="BoardNavigationItem" Content="Board" IsEnabled="False" Tag="board">
                        <NavigationViewItem.Icon><SymbolIcon Symbol="Play" /></NavigationViewItem.Icon>
                    </NavigationViewItem>
                </NavigationView.MenuItems>
                <NavigationView.PaneFooter>
                    <StackPanel Margin="0,0,0,8" Spacing="8">
                        <Border
                            Margin="8,0"
                            Padding="10"
                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            CornerRadius="6">
                            <Grid ColumnSpacing="10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="28" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="16"
                                    Glyph="&#xE77B;" />
                                <StackPanel Grid.Column="1" Spacing="1">
                                    <TextBlock
                                        x:Name="AccountName"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Text="Signed in"
                                        Style="{StaticResource CaptionTextBlockStyle}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Button
                            Margin="8,0"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Left"
                            Click="ChangeBackend_Click">
                            <StackPanel Orientation="Horizontal" Spacing="12">
                                <FontIcon
                                    FontFamily="Segoe Fluent Icons"
                                    FontSize="16"
                                    Glyph="&#xE8AB;" />
                                <TextBlock Text="Switch service" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </NavigationView.PaneFooter>

                <Grid>
                    <ScrollViewer
                        x:Name="NewGamePane"
                        HorizontalContentAlignment="Stretch"
                        HorizontalScrollBarVisibility="Disabled">
                        <Grid
                            MaxWidth="940"
                            Padding="32,28,32,48"
                            HorizontalAlignment="Center">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="4,0,0,24" Spacing="6">
                                <TextBlock
                                    FontSize="28"
                                    FontWeight="SemiBold"
                                    Text="New game" />
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="Set up a game against a computer opponent."
                                    TextWrapping="Wrap"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>

                            <StackPanel Grid.Row="1" Margin="0,0,0,24" Spacing="8">
                                <TextBlock Margin="4,0" Text="Game" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Padding="20,16" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="18"
                                                Glyph="&#xE77B;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Opponent" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Choose the computer strength."
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="OpponentPicker"
                                                Grid.Column="2"
                                                HorizontalAlignment="Stretch" />
                                        </Grid>

                                        <Rectangle Grid.Row="1" Margin="68,0,0,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid Grid.Row="2" Padding="20,16" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="18"
                                                Glyph="&#xE8B1;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Variant" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Select the rules for this game."
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="VariantPicker"
                                                Grid.Column="2"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="VariantPicker_SelectionChanged" />
                                        </Grid>

                                        <Rectangle Grid.Row="3" Margin="68,0,0,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid Grid.Row="4" Padding="20,16" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="18"
                                                Glyph="&#xE7C1;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Play as" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Pick a side or let the service decide."
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="ColorPicker"
                                                Grid.Column="2"
                                                HorizontalAlignment="Stretch" />
                                        </Grid>

                                        <Rectangle
                                            x:Name="PositionDivider"
                                            Grid.Row="5"
                                            Margin="68,0,0,0"
                                            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
                                            Visibility="Collapsed" />

                                        <Grid
                                            x:Name="PositionPanel"
                                            Grid.Row="6"
                                            Padding="20,16"
                                            ColumnSpacing="16"
                                            Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="360" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="18"
                                                Glyph="&#xE70F;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Starting position" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Enter a valid X-FEN position."
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <TextBox
                                                x:Name="PositionFen"
                                                Grid.Column="2"
                                                AcceptsReturn="False"
                                                PlaceholderText="Paste X-FEN" />
                                        </Grid>
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Row="2" Margin="0,0,0,24" Spacing="8">
                                <TextBlock Margin="4,0" Text="Time control" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <Border
                                    Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="1" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Padding="20,16" ColumnSpacing="16">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="32" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="260" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon
                                                VerticalAlignment="Center"
                                                FontFamily="Segoe Fluent Icons"
                                                FontSize="18"
                                                Glyph="&#xE823;" />
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                                                <TextBlock Text="Mode" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock
                                                    x:Name="TimeControlSummary"
                                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                    Text="Choose how the game is timed."
                                                    TextWrapping="Wrap"
                                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                            </StackPanel>
                                            <ComboBox
                                                x:Name="TimeControlPicker"
                                                Grid.Column="2"
                                                HorizontalAlignment="Stretch"
                                                SelectionChanged="TimeControlPicker_SelectionChanged" />
                                        </Grid>

                                        <Rectangle Grid.Row="1" Margin="68,0,0,0" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />

                                        <Grid
                                            x:Name="ClockOptionsPanel"
                                            Grid.Row="2"
                                            Padding="68,16,20,20"
                                            ColumnSpacing="16"
                                            Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Spacing="7">
                                                <TextBlock Text="Initial time" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <ComboBox
                                                    x:Name="InitialTimePicker"
                                                    HorizontalAlignment="Stretch"
                                                    SelectionChanged="InitialTimePicker_SelectionChanged" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="1" Spacing="7">
                                                <TextBlock Text="Increment per move" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <ComboBox x:Name="IncrementPicker" HorizontalAlignment="Stretch" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel
                                            x:Name="CorrespondenceOptionsPanel"
                                            Grid.Row="2"
                                            Padding="68,16,20,20"
                                            Spacing="7"
                                            Visibility="Collapsed">
                                            <TextBlock Text="Days per move" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                            <ComboBox
                                                x:Name="CorrespondenceDaysPicker"
                                                Width="260"
                                                HorizontalAlignment="Left" />
                                        </StackPanel>

                                        <TextBlock
                                            x:Name="UnlimitedTimeDescription"
                                            Grid.Row="2"
                                            Padding="68,18,20,20"
                                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                            Text="Play without a clock. Take as long as you need for each move."
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </Grid>
                                </Border>
                            </StackPanel>

                            <Grid Grid.Row="3">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ProgressRing
                                    x:Name="CreateGameProgress"
                                    Width="22"
                                    Height="22"
                                    Margin="0,0,12,0"
                                    HorizontalAlignment="Right"
                                    IsActive="True"
                                    Visibility="Collapsed" />
                                <Button
                                    x:Name="CreateGameButton"
                                    Grid.Column="1"
                                    MinWidth="132"
                                    Click="CreateGame_Click"
                                    Content="Create game"
                                    Style="{StaticResource AccentButtonStyle}" />
                            </Grid>
                            <InfoBar
                                x:Name="WorkspaceInfoBar"
                                Grid.Row="4"
                                Margin="0,18,0,0"
                                IsClosable="True"
                                IsOpen="False" />
                        </Grid>
                    </ScrollViewer>

                    <Grid
                        x:Name="GamePane"
                        MaxWidth="1280"
                        Padding="32"
                        HorizontalAlignment="Center"
                        ColumnSpacing="28"
                        Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="320" />
                        </Grid.ColumnDefinitions>

                        <Viewbox
                            MaxWidth="720"
                            MaxHeight="720"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                            Stretch="Uniform">
                            <Border
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="4">
                                <Grid x:Name="BoardGrid" Width="640" Height="640" />
                            </Border>
                        </Viewbox>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="16">
                            <StackPanel Spacing="4">
                                <TextBlock
                                    x:Name="GameVariant"
                                    FontSize="28"
                                    FontWeight="SemiBold" />
                                <TextBlock
                                    x:Name="GameStatus"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    TextWrapping="Wrap"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                            </StackPanel>
                            <Border
                                Padding="16"
                                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <StackPanel Spacing="14">
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="22"
                                            Glyph="&#x265F;" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:Name="BlackPlayer" FontWeight="SemiBold" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="Black"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Grid>
                                    <Rectangle Height="1" Fill="{ThemeResource DividerStrokeColorDefaultBrush}" />
                                    <Grid ColumnSpacing="12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="32" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon
                                            VerticalAlignment="Center"
                                            FontFamily="Segoe UI Symbol"
                                            FontSize="22"
                                            Glyph="&#x2659;" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                                            <TextBlock x:Name="WhitePlayer" FontWeight="SemiBold" />
                                            <TextBlock
                                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                Text="White"
                                                Style="{StaticResource CaptionTextBlockStyle}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                            <CommandBar
                                HorizontalAlignment="Stretch"
                                Background="Transparent"
                                DefaultLabelPosition="Right">
                                <AppBarButton Click="OfferDraw_Click" Label="Offer draw">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE8C2;" /></AppBarButton.Icon>
                                </AppBarButton>
                                <AppBarButton Click="Resign_Click" Label="Resign">
                                    <AppBarButton.Icon><FontIcon Glyph="&#xE7BA;" /></AppBarButton.Icon>
                                </AppBarButton>
                            </CommandBar>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Text="Select a piece, then a highlighted destination."
                                TextWrapping="Wrap"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
